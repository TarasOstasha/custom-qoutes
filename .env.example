# Copy to .env.local and adjust. Required for client-side fetch from the Next app.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Admin (CartIDLog / identify user)
VOLUSION_LOGIN_EMAIL=
VOLUSION_LOGIN_PASSWORD=

# POST /quotes/scrape-cart — Playwright launchPersistentContext (no cookies in API body)
VOLUSION_STORE_CART_URL=https://hxyrr-gdtbo.volusion.store/ShoppingCart.asp
# Optional: Chromium user-data directory. If omitted, defaults to .playwright-volusion-profile
# under the API process working directory.
VOLUSION_PLAYWRIGHT_USER_DATA_DIR=C:\\Users\\Tony Dev\\Documents\\dev\\App\\custom-quote\\playwright-profile\\volusion
# Headless by default. Set to 0/false/no/off for a visible browser session.
VOLUSION_PLAYWRIGHT_HEADLESS=0
