{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-server",
    "sourceMap": false,
    "declaration": false
    ,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "server.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "mock/**/*.ts",
    "lib/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist-electron", "dist-server"]
}
