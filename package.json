{
  "name": "custom-quote",
  "version": "1.0.3",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:api": "tsc -p tsconfig.server.json",
    "db:migrate": "sequelize-cli db:migrate --config config/config.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/config.js",
    "copy:standalone-assets": "node scripts/copy-standalone-assets.js",
    "build:prod": "npm run build && npm run copy:standalone-assets && npm run build:api",
    "start": "next start",
    "api:dev": "ts-node -r ./lib/playwrightSetup.js server.ts",
    "electron:start": "npm run build:prod && electron .",
    "electron:dist": "npm run build:prod && electron-builder --win nsis",
    "postinstall": "playwright install chromium",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "multer": "^2.1.1",
    "next": "^15.5.2",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "playwright": "^1.58.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sequelize": "^6.37.8",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.xyzdisplays.customquote",
    "productName": "Custom Quote",
    "icon": "public/images/favicon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      ".env",
      "dist-server/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "C:/Users/Tony Dev/AppData/Local/ms-playwright",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/images/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://100.68.127.126/updates/custom-quote/"
      }
    ]
  }
}
